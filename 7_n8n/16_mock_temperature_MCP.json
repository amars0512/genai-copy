      "parameters": {
        "description": "Get the current temperature (in Celsius) for a city.",
        "jsCode": "// Mock weather service: no API call, just a local function.\n// Known cities get a fixed temperature; any other city gets a stable made-up one.\nconst MOCK = { mumbai: 31, delhi: 27, pune: 26, bengaluru: 24, chennai: 32, london: 12, 'new york': 15, tokyo: 18 };\n\nconst city = String(query.city || '').trim();\nif (!city) return 'Please provide a city name.';\n\nconst key = city.toLowerCase();\nlet tempC = MOCK[key];\nif (tempC === undefined) {\n  let h = 0;\n  for (const ch of key) h = (h * 31 + ch.charCodeAt(0)) % 1000;\n  tempC = 5 + (h % 30);   // 5..34 C, always the same for the same city\n}\nreturn JSON.stringify({ city, temperature_c: tempC, source: 'mock data (not real weather)' });",
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"city\": {\n      \"type\": \"string\",\n      \"description\": \"City name, e.g. Mumbai\"\n    }\n  },\n  \"required\": [\n    \"city\"\n  ]\n}"
      },
